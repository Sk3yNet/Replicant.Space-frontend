# Environment variables for the Portainer stack (Stacks ▸ your stack ▸ Environment variables).
# Copy the names; never commit real values.

# --- both modes -------------------------------------------------------------------------------
PUBLIC_HOST=replicant.yourdomain.com
CF_TUNNEL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_COOKIE_SECRET=
TZ=America/New_York

# --- single user (docker-compose.yml) --------------------------------------------------------
ALLOWED_EMAIL=you@gmail.com
RS_API_TOKEN=

# --- multi-user (docker-compose.multi.yml) ---------------------------------------------------
# OWNER_EMAIL keeps RS_API_TOKEN (optional here) and the existing database.
OWNER_EMAIL=you@gmail.com
# Who else may sign up: Google addresses, and/or whole domains. OPEN_SIGNUP=1 admits any Google account.
# ALLOWED_EMAIL=friend@gmail.com,other@gmail.com
# ALLOWED_DOMAINS=example.com
# OPEN_SIGNUP=
# MAX_TENANTS=10
# ADMIN_EMAILS=
