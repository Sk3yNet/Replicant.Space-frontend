# Environment variables for the Portainer stack (Stacks ▸ your stack ▸ Environment variables).
# Copy the names; never commit real values.

# --- both modes -------------------------------------------------------------------------------
PUBLIC_HOST=replicant.yourdomain.com
CF_TUNNEL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_COOKIE_SECRET=
TZ=America/New_York

# --- who may sign in -------------------------------------------------------------------------
# docker-compose.yml (multi-user): OWNER_EMAIL keeps RS_API_TOKEN (optional) and the existing database;
# empty = the first address in ALLOWED_EMAIL. Everyone in ALLOWED_EMAIL gets their own server.
# docker-compose.single.yml: everyone in ALLOWED_EMAIL shares one server on RS_API_TOKEN (required there).
OWNER_EMAIL=you@gmail.com
RS_API_TOKEN=
# Comma-separated, no spaces.
ALLOWED_EMAIL=you@gmail.com,friend@gmail.com

# --- multi-user extras (docker-compose.yml) --------------------------------------------------
# Whole domains, and/or OPEN_SIGNUP=1 to admit any Google account.
# ALLOWED_DOMAINS=example.com
# OPEN_SIGNUP=
# MAX_TENANTS=10
# ADMIN_EMAILS=
